# Generate real secrets with scripts/init_env.py; this file is documentation only.
RESCUE_DOMAIN=repair.example.com
RESCUE_ALLOWED_HOSTS=repair.example.com,127.0.0.1,localhost
RESCUE_DATA_ROOT=/srv/rescue/data
RESCUE_WORKSPACE_ROOT=/srv/rescue/executions
RESCUE_EXECUTOR_URL=https://executor.example.com
RESCUE_EXECUTOR_TOKEN=GENERATE_A_RANDOM_32_BYTE_TOKEN
RESCUE_AUTH_KEYS=[]
RESCUE_MODEL_PROVIDER=gemini
RESCUE_MODEL=gemini-3.1-pro-preview
RESCUE_MODEL_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# Alternative: provider=anthropic, model=claude-sonnet-4-6, URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
# For OIDC instead of service keys:
RESCUE_OIDC_ISSUER=
RESCUE_OIDC_AUDIENCE=
RESCUE_OIDC_JWKS_URL=

# Optional browser OAuth. Register clients and approve identities before enabling.
RESCUE_PUBLIC_URL=
RESCUE_GITHUB_OAUTH_CLIENT_ID=
RESCUE_GITHUB_OAUTH_CLIENT_SECRET=
RESCUE_GOOGLE_OAUTH_CLIENT_ID=
RESCUE_GOOGLE_OAUTH_CLIENT_SECRET=
RESCUE_OAUTH_ROLES={}
